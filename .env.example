# 汇率数据面板 - 环境变量配置示例
# 复制本文件为 .env 并按需修改；.env 请勿提交到版本库

# 服务监听地址，0.0.0.0 表示监听所有网卡
APP_HOST=0.0.0.0

# 服务监听端口
APP_PORT=41010

# 每日定时抓取时间（24 小时制，时区 Asia/Shanghai）
CRAWL_HOUR=10
CRAWL_MINUTE=0

# SQLite 数据库文件路径（留空则使用项目目录下的 data/exchange.db）
DB_PATH=

# Frankfurter（USD 基座 / 市场中间价）API 根路径，含 /v2
# 默认公共端点；自托管时可改为 https://your-host/v2
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v2

# 可选：限定数据提供商（逗号分隔），留空则使用 Frankfurter 默认 blended 市场中间价
# 例: ECB,BOJ  （详见 https://frankfurter.dev ）
FRANKFURTER_PROVIDERS=

# 说明：USD 与其它基座共用 CRAWL_HOUR/CRAWL_MINUTE（Asia/Shanghai）一并抓取；
# Frankfurter 为市场参考中间价，勿与 SAFE 官方中间价或 BI/HKAB 卖出价直接比较绝对水平。
